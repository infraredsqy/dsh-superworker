{
  "name": "dsh-superworker",
  "version": "0.1.1-rc.2",
  "description": "The `.superworker/` pipeline record as a work panel in DSH: the host half reads that record for the current session's workspace and hands it to the browser half",
  "license": "MIT",
  "author": "Infrareds <infraredsaw@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/infraredsqy/dsh-superworker.git"
  },
  "publishConfig": {
    "tag": "latest"
  },
  "type": "module",
  "main": "lib/host/index.js",
  "types": "lib/types/host/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/host/index.d.ts",
      "default": "./lib/host/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/host/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "locale/*.json",
    "cordis.patch.yml",
    "packages/superworker-core/dist/**/*",
    "packages/superworker-core/plugins/**/*"
  ],
  "scripts": {
    "build:products": "pnpm --filter superworker-core build && npm run types && npm run bundle && npm run bundle:client",
    "prepack": "npm run build:products",
    "bundle": "tsdown",
    "bundle:client": "node tools/build-client.mjs",
    "watch": "tsdown --watch",
    "types": "tsc -b tsconfig.host.json",
    "types:model": "tsc -p src/model/tsconfig.json",
    "types:client": "tsc -p src/client/tsconfig.json",
    "typecheck": "tsc -b tsconfig.host.json --noEmit && tsc -p src/model/tsconfig.json && tsc -p src/client/tsconfig.json && pnpm --filter superworker-core run typecheck",
    "test": "npm run build:products && node tools/test-all.mjs"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0-0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-typert-protocol": "^0.2.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-agent": "0.2.1-rc.4",
    "@deepseek-ai/dsh-api-gateway": "0.2.1-rc.4",
    "@deepseek-ai/dsh-api-workspace-files": "0.2.1-rc.4",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.4",
    "@deepseek-ai/dsh-sandbox-policy": "0.2.1-rc.4",
    "@deepseek-ai/dsh-session": "0.2.1-rc.4",
    "@deepseek-ai/dsh-subprocess": "0.2.1-rc.4",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-rc.4",
    "@deepseek-ai/dsh-typert-registry": "0.2.1-rc.4",
    "@types/node": "^22.20.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "jsdom": "^26.1.0",
    "superworker-core": "workspace:*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rolldown": "^1.2.14",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3"
  }
}