# Records do not go through EOL conversion: the tool writes CRLF on Windows, and no machine's
# core.autocrlf should rewrite that.
** -text

# Records merge entry-wise, not line by line; the driver is `pf-merge-ledger`, and the command is
# registered in each machine's git config (`pf register`).
ideas.json merge=pf
state.json merge=pf
instructions.json merge=pf
signals/** merge=pf
